{
  "version": 1,
  "sdk_version": "0.26.2",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://jpggwhyabwettgwgktdm.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "eagle-maritime-cog-os",
      "version": "0.1.0",
      "title": "Eagle-Maritime COG. OS"
    },
    "tools": [
      {
        "name": "fleet_compliance_summary",
        "title": "Fleet compliance summary",
        "description": "Summarize fleet compliance: vessel count, certificates expired or expiring within 90 days, and open incidents.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_vessels",
        "title": "List vessels",
        "description": "List vessels in the signed-in user's organization fleet, optionally filtered by name or IMO number.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "search": {
              "description": "Filter by vessel name or IMO number.",
              "type": "string",
              "minLength": 1
            },
            "limit": {
              "default": 25,
              "description": "Maximum vessels to return.",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_vessel_profile",
        "title": "Get vessel profile",
        "description": "Get the full particulars of one vessel plus its certificates, by vessel id or IMO number.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "vessel_id": {
              "description": "Vessel UUID.",
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "imo_number": {
              "description": "IMO number, used when vessel_id is unknown.",
              "type": "string",
              "minLength": 3
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_expiring_certificates",
        "title": "List expiring certificates",
        "description": "List statutory and class certificates in the fleet that expire within a given number of days.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "within_days": {
              "default": 90,
              "description": "Look-ahead window in days.",
              "type": "integer",
              "minimum": 1,
              "maximum": 365
            },
            "vessel_id": {
              "description": "Restrict to a single vessel.",
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "limit": {
              "default": 50,
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_audit_findings",
        "title": "List audit findings",
        "description": "List audit findings (non-conformities, observations) raised across the organization's audits.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "vessel_id": {
              "description": "Restrict to findings from audits on this vessel.",
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "status": {
              "description": "Filter by finding status, e.g. open or closed.",
              "type": "string",
              "minLength": 1
            },
            "limit": {
              "default": 25,
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_incidents",
        "title": "List incidents",
        "description": "List reported safety, pollution and near-miss incidents for the organization's fleet.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "vessel_id": {
              "description": "Restrict to a single vessel.",
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "severity": {
              "description": "Filter by severity.",
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high",
                "critical"
              ]
            },
            "since": {
              "description": "Only incidents on or after this date (YYYY-MM-DD).",
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "limit": {
              "default": 25,
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "report_incident",
        "title": "Report an incident",
        "description": "Create a new incident record (safety, pollution, near-miss) for a vessel in the organization.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 3,
              "maxLength": 200,
              "description": "Short incident title."
            },
            "incident_type": {
              "type": "string",
              "minLength": 2,
              "maxLength": 100,
              "description": "Incident type, e.g. Near Miss, Injury, Pollution."
            },
            "incident_date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Date of the incident (YYYY-MM-DD)."
            },
            "severity": {
              "default": "low",
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high",
                "critical"
              ]
            },
            "vessel_id": {
              "description": "Vessel involved.",
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "location": {
              "description": "Position or port where it happened.",
              "type": "string",
              "maxLength": 200
            },
            "description": {
              "description": "What happened.",
              "type": "string",
              "maxLength": 4000
            }
          },
          "required": [
            "title",
            "incident_type",
            "incident_date"
          ]
        },
        "outputSchema": null
      }
    ]
  }
}
